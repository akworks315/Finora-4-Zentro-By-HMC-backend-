# --- Required (set these in Vercel > backend project > Settings > Environment Variables) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=finora_finance

# --- Optional ---
CLIENT_ORIGIN=https://finora-4-zentro-by-hmc-frontend.vercel.app
SYNC_API_KEY=change-me

# --- Automatic WhatsApp updates to the customer (WhatsApp Business Cloud API from Meta) ---
# Without these the app still works: after every payment it shows a "Send on WhatsApp" button with the message ready.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OWNER=
